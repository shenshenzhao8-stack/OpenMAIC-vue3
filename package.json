{
  "name": "@ailearning/openmaic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenMAIC 课堂播放器（Vue 3；slide/quiz/interactive + speech/spotlight/laser；独立 SPA 与可嵌入组件双形态）",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clear": "rm -fr node_modules && rm -fr dist"
  },
  "dependencies": {
    "pinia": "~2.1.7",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~5.9.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
